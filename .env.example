# Create a Vimeo API app at https://developer.vimeo.com/apps
VIMEO_ACCESS_TOKEN=your_vimeo_personal_access_token
VIMEO_USER_ID=your_vimeo_user_id
VDOCIPHER_API_SECRET=your_vdocipher_api_secret
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Cloudflare Turnstile + signup rate limiting (server secrets must never use NEXT_PUBLIC_)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
SIGNUP_RATE_LIMIT_SALT=use_a_long_random_secret_value
